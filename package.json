{
  "name": "airtable-clone-demo",
  "version": "0.1.0",
  "private": true,
  "description": "A realtime Airtable-style B2B workspace with public forms, analytics, organization billing, and approval-gated AI.",
  "keywords": [
    "airtable",
    "clerk",
    "collaboration",
    "convex",
    "database",
    "forms",
    "nextjs",
    "realtime"
  ],
  "homepage": "https://github.com/sonnysangha/airtable-clone-demo#readme",
  "bugs": {
    "url": "https://github.com/sonnysangha/airtable-clone-demo/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sonnysangha/airtable-clone-demo.git"
  },
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:next": "next dev",
    "dev:convex": "convex dev",
    "build": "next build --webpack",
    "build:experimental:turbopack": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && vitest run --config vitest.convex.config.mts",
    "test:convex": "vitest run --config vitest.convex.config.mts",
    "test:watch": "vitest",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:connected": "node scripts/run-e2e.mjs --connected",
    "convex:codegen": "convex codegen --typecheck disable",
    "convex:deploy": "convex deploy --cmd 'pnpm build'",
    "seed:demo": "node scripts/seed-demo.mjs",
    "eve:build": "eve build",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@clerk/backend": "3.14.0",
    "@clerk/clerk-js": "6.25.12",
    "@clerk/nextjs": "7.6.3",
    "@clerk/ui": "^1.27.1",
    "@convex-dev/aggregate": "0.2.2",
    "@convex-dev/migrations": "^0.3.6",
    "@convex-dev/presence": "^0.4.0",
    "@convex-dev/rate-limiter": "0.3.2",
    "@hookform/resolvers": "5.5.7",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.14.9",
    "ai": "7.0.42",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "convex": "1.42.3",
    "convex-helpers": "0.1.120",
    "date-fns": "4.4.0",
    "eve": "0.27.13",
    "geist": "1.7.2",
    "jittered-fractional-indexing": "1.0.1",
    "lucide-react": "1.28.0",
    "next": "16.2.12",
    "next-themes": "0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.83.0",
    "recharts": "3.10.1",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@clerk/testing": "^2.2.15",
    "@edge-runtime/vm": "5.0.0",
    "@eslint/compat": "^2.1.0",
    "@playwright/test": "1.62.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.0.5",
    "babel-plugin-react-compiler": "1.0.0",
    "convex-test": "0.0.54",
    "eslint": "10.8.0",
    "eslint-config-next": "16.2.12",
    "jsdom": "30.0.1",
    "shadcn": "4.16.0",
    "tailwindcss": "4.3.3",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vercel": "58.4.0",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
