# Basecraft environment
#
# Nothing here is required for local development: with no DATABASE_URL the app
# uses an embedded PGlite database, and with no Factory credentials it runs in
# local single-tenant mode. Copy this file to .env.local and fill in only what
# you need. Never commit real secrets.

# Database ------------------------------------------------------------------
# pglite:<dir>     embedded Postgres (default when unset: .data/pglite)
# pglite:memory    in-memory, throwaway
# postgres://...   ordinary Postgres
# postgres://...neon.tech/...   Neon (HTTP driver)
DATABASE_URL=

# Factory visitor auth ------------------------------------------------------
# Both values are needed to turn on login; without them every request is the
# local single-tenant workspace.
FACTORY_VISITOR_AUTH_URL=
FACTORY_VISITOR_AUTH_TOKEN=

# Factory app-ai ------------------------------------------------------------
# Assistant credentials. Without them the assistant answers with an honest
# "not available" message instead of pretending to have an answer.
FACTORY_APP_AI_URL=
FACTORY_APP_AI_TOKEN=

# Optional OpenAI-compatible gateway ---------------------------------------
# Only used when FACTORY_APP_AI_URL is empty.
LLM_GATEWAY_BASE_URL=
LLM_GATEWAY_API_KEY=
LLM_GATEWAY_MODEL=

# App origin ---------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Preferred origin for visitor-auth callbacks on preview deployments.
FACTORY_PREVIEW_HOST=

# Attachments --------------------------------------------------------------
# postgres (default, durable) or fs (local debugging only)
ATTACHMENT_STORAGE=postgres
# Directory for the fs adapter; ignored by the Postgres store.
UPLOAD_DIR=.data/uploads
