# Basecraft environment
#
# Nothing here is required for local development: with no DATABASE_URL the app
# uses an embedded PGlite database, and with no Factory credentials it runs in
# local single-tenant mode. Copy this file to .env.local and fill in only what
# you need. Never commit real secrets.

# Database ------------------------------------------------------------------
# pglite:<dir>     embedded Postgres (default when unset: .data/pglite)
# pglite:memory    in-memory, throwaway
# postgres://...   ordinary Postgres
# postgres://...neon.tech/...   Neon (HTTP driver)
DATABASE_URL=

# Factory visitor auth ------------------------------------------------------
# Both values are needed to turn on login. A deployment (NODE_ENV=production
# or any VERCEL_ENV) without them fails closed: authenticated APIs answer
# 503 AUTH_NOT_CONFIGURED instead of handing out a local session.
FACTORY_VISITOR_AUTH_URL=
FACTORY_VISITOR_AUTH_TOKEN=

# Single-tenant mode --------------------------------------------------------
# Set to 1 to keep the local single-tenant workspace on a deployed instance
# (for example a private self-hosted box). Never enable it on a public
# deployment: every request would be treated as local-user in local-org.
# Local development (NODE_ENV != production, no VERCEL_ENV) is always allowed.
ALLOW_LOCAL_WORKSPACE=

# Public form protection ----------------------------------------------------
# Optional Cloudflare Turnstile pair. When the secret is set, public
# submissions must send the widget token as a `cf-turnstile-response` JSON
# field (or request header) and the server verifies it before accepting the
# response; the site key is the public half that renders the widget in the
# browser. Set both or neither. Public submit, metric, and upload endpoints are
# always rate limited per IP + form (10 submissions/min, 60 metrics/min, 20
# uploads/min), with or without Turnstile.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Factory app-ai ------------------------------------------------------------
# Assistant credentials. Without them the assistant answers with an honest
# "not available" message instead of pretending to have an answer.
FACTORY_APP_AI_URL=
FACTORY_APP_AI_TOKEN=

# Optional OpenAI-compatible gateway ---------------------------------------
# Only used when FACTORY_APP_AI_URL is empty.
LLM_GATEWAY_BASE_URL=
LLM_GATEWAY_API_KEY=
LLM_GATEWAY_MODEL=

# App origin ---------------------------------------------------------------
# Empty means http://localhost:3000.
NEXT_PUBLIC_APP_URL=
# Preferred origin for visitor-auth callbacks on preview deployments.
FACTORY_PREVIEW_HOST=

# Attachments --------------------------------------------------------------
# Empty means postgres (durable); fs is local debugging only.
ATTACHMENT_STORAGE=
# Directory for the fs adapter; ignored by the Postgres store. Empty means
# .data/uploads.
UPLOAD_DIR=
