# Next.js / Vercel web runtime
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk (use a development instance locally)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_JS_VERSION=6.25.12
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/onboarding
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# Convex (populated by `pnpm convex dev`)
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Vercel AI Gateway / EVE
AI_GATEWAY_API_KEY=
CLERK_AI_FEATURE=ai_assistant
NEXT_PUBLIC_EVE_HOST=
EVE_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
EVE_CONVEX_BRIDGE_URL=
EVE_SESSION_OWNERSHIP_URL=
EVE_CONVEX_HMAC_SECRET=
EVE_CONVEX_HMAC_KEY_ID=primary

# Convex deployment runtime (set with `convex env set` or in the dashboard)
CLERK_JWT_ISSUER_DOMAIN=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=localhost
FORM_ANALYTICS_HASH_SALT=

# Public form browser runtime
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Connected Playwright tests (use a dedicated disposable development org)
E2E_CLERK_ORGANIZATION_NAME=

# Vercel CI only; scope this key to the target Convex deployment
CONVEX_DEPLOY_KEY=
